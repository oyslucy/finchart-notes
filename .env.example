# API settings. Copy to apps/api/.env for local runs; on the VM it lives at ~/finchart/.env.
APP_ENV=development
# gemini | claude_cli (local development only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated; anyone else gets 403
ALLOWED_EMAILS=
RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760
WEB_DIST_DIR=
