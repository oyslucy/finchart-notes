# API settings. Copy to apps/api/.env for local runs; on the VM it lives at ~/finchart/.env.
APP_ENV=development
# gemini | claude_cli (local development only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional comma-separated allow-list; leave empty to let anyone sign up
ALLOWED_USERNAMES=
# SQLite database and images; the Docker image uses /data
DATA_DIR=data
BACKUP_BUCKET=finchart-backups
RATE_LIMIT_PER_MINUTE=10
DAILY_ANALYSES_PER_USER=30
SIGNUPS_PER_IP_PER_HOUR=5
LOGIN_ATTEMPTS_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760
WEB_DIST_DIR=
# Base URL used in links sent by the Telegram bot
PUBLIC_BASE_URL=https://finchart-notes.duckdns.org

# Telegram bot (optional). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string (16+ chars); Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# webhook (production) | polling (local development) | off
TELEGRAM_MODE=webhook
